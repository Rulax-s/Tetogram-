# Copy to ignored tetogram.properties for local builds. Never commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional provider integrations; require your own Android app/certificate restrictions.
GOOGLE_MAPS_API_KEY=
GOOGLE_AUTH_CLIENT_ID=
SAFETYNET_KEY=

# Private PKCS12 debug-key password (do not commit a real value)
DEBUG_KEYSTORE_PASSWORD=
